{
  "name": "CMND",
  "scopeName": "source.cmnd",
  "fileTypes": ["cmnd"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#command" }
  ],
  "repository": {
    "comment": {
      "patterns": [
        {
          "comment": "Disabled command: !Namespace:Setting = value",
          "match": "^\\s*(!\\s*[A-Za-z0-9]+:[A-Za-z0-9]+\\s*=.*)$",
          "name": "comment.line.exclamation.disabled.cmnd"
        },
        {
          "match": "!.*$",
          "name": "comment.line.exclamation.cmnd"
        }
      ]
    },
    "command": {
      "patterns": [
        {
          "comment": "Boolean value: on/off/true/false",
          "match": "^\\s*([A-Za-z0-9]+)(:)([A-Za-z0-9]+)\\s*(=)\\s*(on|off|true|false)\\s*$",
          "captures": {
            "1": { "name": "entity.name.namespace.cmnd" },
            "2": { "name": "punctuation.separator.namespace.cmnd" },
            "3": { "name": "variable.parameter.cmnd" },
            "4": { "name": "keyword.operator.assignment.cmnd" },
            "5": { "name": "constant.language.boolean.cmnd" }
          }
        },
        {
          "comment": "Float / scientific notation  e.g. 13000.  0.1383  1.5e-3",
          "match": "^\\s*([A-Za-z0-9]+)(:)([A-Za-z0-9]+)\\s*(=)\\s*(-?[0-9]+\\.?[0-9]*[eE][+-]?[0-9]+|-?[0-9]*\\.[0-9]+|-?[0-9]+\\.)\\s*$",
          "captures": {
            "1": { "name": "entity.name.namespace.cmnd" },
            "2": { "name": "punctuation.separator.namespace.cmnd" },
            "3": { "name": "variable.parameter.cmnd" },
            "4": { "name": "keyword.operator.assignment.cmnd" },
            "5": { "name": "constant.numeric.cmnd" }
          }
        },
        {
          "comment": "Integer (includes PDG particle codes: 2212, -211, …)",
          "match": "^\\s*([A-Za-z0-9]+)(:)([A-Za-z0-9]+)\\s*(=)\\s*(-?[0-9]+)\\s*$",
          "captures": {
            "1": { "name": "entity.name.namespace.cmnd" },
            "2": { "name": "punctuation.separator.namespace.cmnd" },
            "3": { "name": "variable.parameter.cmnd" },
            "4": { "name": "keyword.operator.assignment.cmnd" },
            "5": { "name": "constant.numeric.cmnd" }
          }
        },
        {
          "comment": "String / identifier value (PDF sets, tunes, process names, …)",
          "match": "^\\s*([A-Za-z0-9]+)(:)([A-Za-z0-9]+)\\s*(=)\\s*(.+)$",
          "captures": {
            "1": { "name": "entity.name.namespace.cmnd" },
            "2": { "name": "punctuation.separator.namespace.cmnd" },
            "3": { "name": "variable.parameter.cmnd" },
            "4": { "name": "keyword.operator.assignment.cmnd" },
            "5": { "name": "string.unquoted.cmnd" }
          }
        }
      ]
    }
  }
}
