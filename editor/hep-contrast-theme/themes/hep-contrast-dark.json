  "tokenColors": [
    {
      "name": "Base text",
      "scope": [
        "source",
        "text"
      ],
      "settings": {
        "foreground": "#D4D4D4"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#676E95",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc comment tags",
      "scope": [
        "comment.block.documentation storage.type.class.jsdoc",
        "comment.block.doxygen keyword",
        "comment.line.double-slash.doxygen keyword",
        "storage.type.class.jsdoc"
      ],
      "settings": {
        "foreground": "#7070A0",
        "fontStyle": "italic bold"
      }
    },
    {
      "name": "Doc comment parameter names",
      "scope": "comment.block.doxygen variable",
      "settings": {
        "foreground": "#89DDFF",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Control-flow keywords",
      "scope": [
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.return",
        "keyword.control.exception"
      ],
      "settings": {
        "foreground": "#FF79C6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Other keywords",
      "scope": [
        "keyword",
        "keyword.other",
        "storage.modifier",
        "storage.type.modifier"
      ],
      "settings": {
        "foreground": "#FF79C6"
      }
    },
    {
      "name": "C++ storage types (int, double, void, auto, …)",
      "scope": [
        "storage.type",
        "storage.type.primitive",
        "storage.type.built-in",
        "keyword.type"
      ],
      "settings": {
        "foreground": "#FF79C6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "C++ new / delete / sizeof / this",
      "scope": [
        "keyword.operator.new",
        "keyword.operator.delete",
        "keyword.operator.sizeof",
        "variable.language.this",
        "variable.language.self"
      ],
      "settings": {
        "foreground": "#FF79C6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Python self / cls",
      "scope": [
        "variable.parameter.function.language.special"
      ],
      "settings": {
        "foreground": "#FF79C6",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "import / from / as",
      "scope": [
        "keyword.control.import",
        "keyword.control.from-import",
        "keyword.other.import",
        "keyword.other.use"
      ],
      "settings": {
        "foreground": "#FF79C6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Preprocessor directive",
      "scope": [
        "keyword.control.directive",
        "keyword.control.directive.include",
        "keyword.control.directive.define",
        "keyword.control.directive.pragma",
        "keyword.control.directive.conditional",
        "meta.preprocessor keyword",
        "meta.preprocessor.include keyword"
      ],
      "settings": {
        "foreground": "#FFAB40",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Macro names",
      "scope": [
        "entity.name.function.preprocessor",
        "meta.preprocessor.macro entity.name.function"
      ],
      "settings": {
        "foreground": "#FFAB40"
      }
    },
    {
      "name": "Preprocessor include path",
      "scope": [
        "meta.preprocessor.include string",
        "string.quoted.other.lt-gt.include"
      ],
      "settings": {
        "foreground": "#F07178"
      }
    },
    {
      "name": "Class / struct / enum names",
      "scope": [
        "entity.name.type",
        "entity.name.type.class",
        "entity.name.type.struct",
        "entity.name.type.enum",
        "entity.name.type.template",
        "entity.name.class",
        "support.class"
      ],
      "settings": {
        "foreground": "#FF79C6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Inherited / used type",
      "scope": [
        "entity.other.inherited-class",
        "entity.name.type.base-class"
      ],
      "settings": {
        "foreground": "#FF79C6",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Python decorators",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.definition.decorator"
      ],
      "settings": {
        "foreground": "#FF79C6",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Template type parameters",
      "scope": [
        "storage.type.template",
        "entity.name.type.template-parameter"
      ],
      "settings": {
        "foreground": "#FF79C6"
      }
    },
    {
      "name": "Namespace names",
      "scope": [
        "entity.name.namespace",
        "entity.name.type.namespace"
      ],
      "settings": {
        "foreground": "#C792EA"
      }
    },
    {
      "name": "Scope resolution ::",
      "scope": [
        "punctuation.separator.scope-resolution",
        "punctuation.accessor.double-colon"
      ],
      "settings": {
        "foreground": "#C792EA"
      }
    },
    {
      "name": "Function / method definition",
      "scope": [
        "entity.name.function",
        "entity.name.function.member",
        "entity.name.function.definition"
      ],
      "settings": {
        "foreground": "#6BB5FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Function call",
      "scope": [
        "meta.function-call entity.name.function",
        "meta.function-call.generic entity.name.function"
      ],
      "settings": {
        "foreground": "#6BB5FF"
      }
    },
    {
      "name": "Support functions",
      "scope": [
        "support.function",
        "support.function.builtin",
        "support.function.std"
      ],
      "settings": {
        "foreground": "#6BB5FF"
      }
    },
    {
      "name": "Lambda",
      "scope": [
        "meta.lambda",
        "storage.type.lambda",
        "punctuation.definition.lambda"
      ],
      "settings": {
        "foreground": "#6BB5FF",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Function parameters",
      "scope": [
        "variable.parameter",
        "meta.function.parameter variable"
      ],
      "settings": {
        "foreground": "#89DDFF"
      }
    },
    {
      "name": "Member variables",
      "scope": [
        "variable.other.member",
        "variable.other.property",
        "variable.other.object.property"
      ],
      "settings": {
        "foreground": "#BBBBBB"
      }
    },
    {
      "name": "Local / other variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.local",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#D4D4D4"
      }
    },
    {
      "name": "Constants (ALL_CAPS / constexpr)",
      "scope": [
        "variable.other.constant",
        "entity.name.variable.constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#F78C6C",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Python builtins",
      "scope": "support.function.builtin.python",
      "settings": {
        "foreground": "#FF79C6"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.quoted.double",
        "string.quoted.single",
        "string.template"
      ],
      "settings": {
        "foreground": "#F07178"
      }
    },
    {
      "name": "Raw / byte strings",
      "scope": [
        "string.quoted.raw",
        "string.quoted.other",
        "string.other"
      ],
      "settings": {
        "foreground": "#F07178",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Escape sequences",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#FFAB40",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric",
        "constant.numeric.integer",
        "constant.numeric.float",
        "constant.numeric.hex",
        "constant.numeric.octal",
        "constant.numeric.binary"
      ],
      "settings": {
        "foreground": "#F78C6C",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Boolean / null / nullptr / None",
      "scope": [
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.nullptr"
      ],
      "settings": {
        "foreground": "#FF79C6",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.arithmetic",
        "keyword.operator.assignment",
        "keyword.operator.comparison",
        "keyword.operator.logical",
        "keyword.operator.bitwise",
        "keyword.operator.increment",
        "keyword.operator.decrement",
        "keyword.operator.pointer",
        "keyword.operator.address"
      ],
      "settings": {
        "foreground": "#FFCB6B",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Arrow / member access",
      "scope": [
        "punctuation.accessor",
        "punctuation.separator.dot-access",
        "punctuation.accessor.arrow"
      ],
      "settings": {
        "foreground": "#FFCB6B"
      }
    },
    {
      "name": "Brackets / parens / braces",
      "scope": [
        "punctuation.section",
        "punctuation.section.block",
        "punctuation.section.parens",
        "punctuation.definition.bracket",
        "meta.brace.round",
        "meta.brace.square",
        "meta.brace.curly"
      ],
      "settings": {
        "foreground": "#AAAAAA"
      }
    },
    {
      "name": "Semicolons / commas",
      "scope": [
        "punctuation.terminator",
        "punctuation.separator.comma",
        "punctuation.separator.colon"
      ],
      "settings": {
        "foreground": "#888888"
      }
    },
    {
      "name": "Template angle brackets",
      "scope": [
        "punctuation.section.angle-brackets",
        "punctuation.definition.typeparameters"
      ],
      "settings": {
        "foreground": "#FF79C6"
      }
    },
    {
      "name": "C++ cast keywords",
      "scope": [
        "keyword.operator.cast",
        "keyword.operator.word",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#FF79C6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "C++ override / final / virtual / inline / constexpr",
      "scope": [
        "storage.modifier.override",
        "storage.modifier.final",
        "storage.modifier.virtual",
        "storage.modifier.inline",
        "storage.modifier.constexpr",
        "storage.modifier.explicit"
      ],
      "settings": {
        "foreground": "#FF79C6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Pointer / reference declarators",
      "scope": [
        "storage.modifier.pointer",
        "storage.modifier.reference"
      ],
      "settings": {
        "foreground": "#AAAAAA",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Python f-string braces",
      "scope": [
        "punctuation.definition.template-expression",
        "meta.fstring punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#FFAB40"
      }
    },
    {
      "name": "Python magic methods",
      "scope": [
        "support.function.magic",
        "meta.function.python entity.name.function.magic"
      ],
      "settings": {
        "foreground": "#6BB5FF",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Python type hints",
      "scope": [
        "meta.function.annotation",
        "meta.function.annotation.return"
      ],
      "settings": {
        "foreground": "#FF79C6"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "heading.1 entity.name",
        "heading.2 entity.name"
      ],
      "settings": {
        "foreground": "#4FC3F7",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": "markup.bold",
      "settings": {
        "foreground": "#D4D4D4",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": "markup.italic",
      "settings": {
        "foreground": "#D4D4D4",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown inline code",
      "scope": "markup.inline.raw",
      "settings": {
        "foreground": "#FF79C6"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#4FC3F7"
      }
    },
    {
      "name": "CMake commands",
      "scope": "keyword.cmake",
      "settings": {
        "foreground": "#6BB5FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "CMake variables",
      "scope": [
        "variable.other.cmake",
        "variable.cmake"
      ],
      "settings": {
        "foreground": "#F78C6C"
      }
    },
    {
      "name": "Shell built-in commands",
      "scope": "support.function.builtin.shell",
      "settings": {
        "foreground": "#FF79C6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Shell variable expansion",
      "scope": [
        "variable.other.normal.shell",
        "punctuation.definition.variable.shell"
      ],
      "settings": {
        "foreground": "#FFAB40"
      }
    },
    {
      "name": "JSON / YAML / TOML booleans",
      "scope": [
        "constant.language.json",
        "constant.language.yaml",
        "constant.language.toml"
      ],
      "settings": {
        "foreground": "#4FC3F7",
        "fontStyle": "bold"
      }
    },
    {
      "name": "TOML / YAML keys",
      "scope": [
        "support.type.property-name",
        "entity.name.tag.yaml",
        "keyword.key.group.toml",
