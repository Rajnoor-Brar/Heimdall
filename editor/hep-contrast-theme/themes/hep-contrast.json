  "tokenColors": [
    {
      "name": "Base text",
      "scope": [
        "source",
        "text"
      ],
      "settings": {
        "foreground": "#0A0A0A"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#777777",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc comment tags",
      "scope": [
        "comment.block.documentation storage.type.class.jsdoc",
        "comment.block.documentation entity.name.type",
        "storage.type.class.jsdoc",
        "comment.block.doxygen keyword",
        "comment.line.double-slash.doxygen keyword"
      ],
      "settings": {
        "foreground": "#555577",
        "fontStyle": "italic bold"
      }
    },
    {
      "name": "Doc comment parameter names",
      "scope": "comment.block.doxygen variable",
      "settings": {
        "foreground": "#2072AF",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Control-flow keywords",
      "scope": [
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.return",
        "keyword.control.exception"
      ],
      "settings": {
        "foreground": "#D71868",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Other keywords",
      "scope": [
        "keyword",
        "keyword.other",
        "storage.modifier",
        "storage.type.modifier"
      ],
      "settings": {
        "foreground": "#D71868"
      }
    },
    {
      "name": "C++ storage types (int, double, void, auto, ...)",
      "scope": [
        "storage.type",
        "storage.type.primitive",
        "storage.type.built-in",
        "keyword.type"
      ],
      "settings": {
        "foreground": "#D71868",
        "fontStyle": "bold"
      }
    },
    {
      "name": "C++ new / delete / sizeof / this",
      "scope": [
        "keyword.operator.new",
        "keyword.operator.delete",
        "keyword.operator.sizeof",
        "variable.language.this",
        "variable.language.self"
      ],
      "settings": {
        "foreground": "#D71868",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Python self / cls",
      "scope": [
        "variable.parameter.function.language.special"
      ],
      "settings": {
        "foreground": "#D71868",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "import / from / as",
      "scope": [
        "keyword.control.import",
        "keyword.control.from-import",
        "keyword.other.import",
        "keyword.other.use"
      ],
      "settings": {
        "foreground": "#D71868",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Preprocessor directive",
      "scope": [
        "keyword.control.directive",
        "keyword.control.directive.include",
        "keyword.control.directive.define",
        "keyword.control.directive.pragma",
        "keyword.control.directive.conditional",
        "keyword.control.directive.undef",
        "meta.preprocessor keyword",
        "meta.preprocessor.include keyword"
      ],
      "settings": {
        "foreground": "#D75C1E",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Macro names",
      "scope": [
        "entity.name.function.preprocessor",
        "meta.preprocessor.macro entity.name.function"
      ],
      "settings": {
        "foreground": "#D75C1E"
      }
    },
    {
      "name": "Preprocessor include path",
      "scope": [
        "meta.preprocessor.include string",
        "string.quoted.other.lt-gt.include"
      ],
      "settings": {
        "foreground": "#E60026"
      }
    },
    {
      "name": "Class / struct / enum names",
      "scope": [
        "entity.name.type",
        "entity.name.type.class",
        "entity.name.type.struct",
        "entity.name.type.enum",
        "entity.name.type.template",
        "entity.name.class",
        "support.class"
      ],
      "settings": {
        "foreground": "#D71868",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Inherited / used type",
      "scope": [
        "entity.other.inherited-class",
        "entity.name.type.base-class"
      ],
      "settings": {
        "foreground": "#D71868",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Python decorators",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.definition.decorator"
      ],
      "settings": {
        "foreground": "#D71868",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Template type parameters",
      "scope": [
        "storage.type.template",
        "entity.name.type.template-parameter"
      ],
      "settings": {
        "foreground": "#D71868"
      }
    },
    {
      "name": "Namespace names",
      "scope": [
        "entity.name.namespace",
        "entity.name.type.namespace"
      ],
      "settings": {
        "foreground": "#883DA4"
      }
    },
    {
      "name": "Scope resolution ::",
      "scope": [
        "punctuation.separator.scope-resolution",
        "punctuation.accessor.double-colon"
      ],
      "settings": {
        "foreground": "#883DA4"
      }
    },
    {
      "name": "Function / method definition",
      "scope": [
        "entity.name.function",
        "entity.name.function.member",
        "entity.name.function.definition"
      ],
      "settings": {
        "foreground": "#0055CC",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Function call",
      "scope": [
        "meta.function-call entity.name.function",
        "meta.function-call.generic entity.name.function"
      ],
      "settings": {
        "foreground": "#0055CC"
      }
    },
    {
      "name": "Support functions",
      "scope": [
        "support.function",
        "support.function.builtin",
        "support.function.std"
      ],
      "settings": {
        "foreground": "#0055CC"
      }
    },
    {
      "name": "Lambda",
      "scope": [
        "meta.lambda",
        "storage.type.lambda",
        "punctuation.definition.lambda"
      ],
      "settings": {
        "foreground": "#0055CC",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Function parameters",
      "scope": [
        "variable.parameter",
        "meta.function.parameter variable"
      ],
      "settings": {
        "foreground": "#2072AF"
      }
    },
    {
      "name": "Member variables",
      "scope": [
        "variable.other.member",
        "variable.other.property",
        "variable.other.object.property"
      ],
      "settings": {
        "foreground": "#1A1A1A"
      }
    },
    {
      "name": "Local / other variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.local",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#0A0A0A"
      }
    },
    {
      "name": "Constants (ALL_CAPS / constexpr)",
      "scope": [
        "variable.other.constant",
        "entity.name.variable.constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#CC332A",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Python builtins",
      "scope": "support.function.builtin.python",
      "settings": {
        "foreground": "#D71868"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.quoted.double",
        "string.quoted.single",
        "string.template"
      ],
      "settings": {
        "foreground": "#E60026"
      }
    },
    {
      "name": "Raw / byte strings",
      "scope": [
        "string.quoted.raw",
        "string.quoted.other",
        "string.other"
      ],
      "settings": {
        "foreground": "#E60026",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Escape sequences",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#D75C1E",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Printf format specifiers",
      "scope": [
        "constant.other.placeholder",
        "string.interpolated",
        "meta.interpolation"
      ],
      "settings": {
        "foreground": "#D75C1E",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric",
        "constant.numeric.integer",
        "constant.numeric.float",
        "constant.numeric.hex",
        "constant.numeric.octal",
        "constant.numeric.binary"
      ],
      "settings": {
        "foreground": "#CC332A",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Boolean / null / nullptr / None",
      "scope": [
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.nullptr"
      ],
      "settings": {
        "foreground": "#D71868",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.arithmetic",
        "keyword.operator.assignment",
        "keyword.operator.comparison",
        "keyword.operator.logical",
        "keyword.operator.bitwise",
        "keyword.operator.increment",
        "keyword.operator.decrement",
        "keyword.operator.pointer",
        "keyword.operator.address"
      ],
      "settings": {
        "foreground": "#E28512",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Arrow / member access",
      "scope": [
        "punctuation.accessor",
        "punctuation.separator.dot-access",
        "punctuation.accessor.arrow"
      ],
      "settings": {
        "foreground": "#E28512"
      }
    },
    {
      "name": "Brackets / parens / braces",
      "scope": [
        "punctuation.section",
        "punctuation.section.block",
        "punctuation.section.parens",
        "punctuation.definition.bracket",
        "meta.brace.round",
        "meta.brace.square",
        "meta.brace.curly"
      ],
      "settings": {
        "foreground": "#333333"
      }
    },
    {
      "name": "Semicolons / commas",
      "scope": [
        "punctuation.terminator",
        "punctuation.separator.comma",
        "punctuation.separator.colon"
      ],
      "settings": {
        "foreground": "#555555"
      }
    },
    {
      "name": "Template angle brackets",
      "scope": [
        "punctuation.section.angle-brackets",
        "punctuation.definition.typeparameters"
      ],
      "settings": {
        "foreground": "#D71868"
      }
    },
    {
      "name": "C++ cast keywords",
      "scope": [
        "keyword.operator.cast",
        "keyword.operator.word",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#D71868",
        "fontStyle": "bold"
      }
    },
    {
      "name": "C++ override / final / virtual / inline / constexpr",
      "scope": [
        "storage.modifier.override",
        "storage.modifier.final",
        "storage.modifier.virtual",
        "storage.modifier.inline",
        "storage.modifier.constexpr",
        "storage.modifier.explicit"
      ],
      "settings": {
        "foreground": "#D71868",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Pointer / reference declarators",
      "scope": [
        "storage.modifier.pointer",
        "storage.modifier.reference"
      ],
      "settings": {
        "foreground": "#333333",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Python f-string braces",
      "scope": [
        "punctuation.definition.template-expression",
        "meta.fstring punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#D75C1E"
      }
    },
    {
      "name": "Python magic methods",
      "scope": [
        "support.function.magic",
        "meta.function.python entity.name.function.magic"
      ],
      "settings": {
        "foreground": "#0055CC",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Python type hints",
      "scope": [
        "meta.function.annotation",
        "meta.function.annotation.return"
      ],
      "settings": {
        "foreground": "#D71868"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "heading.1 entity.name",
        "heading.2 entity.name"
      ],
      "settings": {
        "foreground": "#0055CC",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": "markup.bold",
      "settings": {
        "foreground": "#0A0A0A",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": "markup.italic",
      "settings": {
        "foreground": "#0A0A0A",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown inline code",
      "scope": "markup.inline.raw",
      "settings": {
        "foreground": "#D71868"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#0055CC"
      }
    },
    {
      "name": "CMake commands",
      "scope": "keyword.cmake",
      "settings": {
        "foreground": "#0055CC",
        "fontStyle": "bold"
      }
    },
    {
      "name": "CMake variables",
      "scope": [
        "variable.other.cmake",
        "variable.cmake"
      ],
      "settings": {
        "foreground": "#CC332A"
      }
    },
    {
      "name": "Shell built-in commands",
      "scope": "support.function.builtin.shell",
      "settings": {
        "foreground": "#D71868",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Shell variable expansion",
      "scope": [
        "variable.other.normal.shell",
        "punctuation.definition.variable.shell"
      ],
      "settings": {
        "foreground": "#D75C1E"
      }
    },
    {
      "name": "Shell flags",
      "scope": "string.unquoted.argument",
      "settings": {
        "foreground": "#0A0A0A"
      }
    },
    {
      "name": "JSON / YAML / TOML keywords and booleans",
      "scope": [
        "constant.language.json",
        "constant.language.yaml",
        "constant.language.toml"
      ],
      "settings": {
        "foreground": "#0055CC",
        "fontStyle": "bold"
      }
    },
    {
      "name": "TOML / YAML keys",
      "scope": [
        "support.type.property-name",
        "entity.name.tag.yaml",
        "keyword.key.group.toml",
        "meta.mapping.key string"
