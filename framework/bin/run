#!/usr/bin/env python3
"""framework/bin/run — the runner's entry point (docs/06_Internals.md §2).

`hep run …`, `hep watch …` and the other runner commands land here. Everything else is in the
`runner` package (framework/runner/) and the tool folders (framework/tools/<tool>/).
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))       # framework/: the runner package

from runner.errors import HepError  # noqa: E402

try:
    from runner.cli import main  # noqa: E402
except HepError as error:            # raised while loading: another Heimdall's $HEP, a broken schema file
    print(error.render(), file=sys.stderr)
    sys.exit(2)

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
