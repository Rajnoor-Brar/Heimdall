# recipes/platforms/mac/Brewfile — what the HEP stack needs from Homebrew; build.sh runs
# `brew bundle --file recipes/platforms/mac/Brewfile`. The macOS counterpart of settings.toml's apt_packages.
#
# Do not also have Homebrew's own root, fastjet, hepmc3, lhapdf, pythia, yoda or rivet installed: the
# build puts Homebrew's include/ and lib/ on its search paths, where they would shadow the stack's.

# build tools
brew "cmake"
brew "pkgconf"
brew "autoconf"
brew "automake"
brew "libtool"
brew "gcc"            # gfortran: Whizard, Sherpa's internal PDFs
brew "python@3.13"    # tomllib for build_stack.py, and the venv's interpreter (build.sh picks it first)

# GNU tools for the framework (put first on PATH by setup.sh): its Makefile is GNU make 4 and uses
# GNU sed -i; hep_env.sh and hep are bash (macOS has bash 3.2)
brew "make"
brew "gnu-sed"
brew "coreutils"
brew "bash"

# libraries
brew "openssl@3"      # ROOT (ssl), its builtin xrootd
brew "gsl"            # ROOT (mathmore), ThePEG, Herwig
brew "tbb"            # ROOT (imt): threads
brew "boost"          # ThePEG, Herwig
brew "fftw"           # ROOT
brew "yaml-cpp"       # LHAPDF
brew "xz"
brew "zstd"           # ROOT; the framework
brew "libzip"         # Sherpa
brew "xerces-c"       # Geant4 (GDML)
brew "ocaml"          # Whizard (O'Mega)
brew "ocaml-findlib"
brew "bdw-gc"         # Whizard
brew "tomlplusplus"   # the framework: Paint, App_Pythia, the module kit
brew "pandoc"         # decks (hep deck): Beamer, pptx and HTML slides; Beamer itself comes with the TeX
brew "poppler"        # decks and sheets: pdftoppm renders a figure's PNG from its PDF, pdfinfo reads sizes

# pdflatex, for sheet figures: a ~100 MB TeX, which asks for your password; uncomment to include it
# cask "basictex"
