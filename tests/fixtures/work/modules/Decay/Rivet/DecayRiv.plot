# BEGIN PLOT /DecayRiv/(.*_)?mass$
XLabel=$m(p\pi^-)$ [GeV]
YLabel=$\mathrm{d}\sigma / \mathrm{d}m$ [pb/GeV]
LogY=1
# END PLOT

# BEGIN PLOT /DecayRiv/(.*_)?energy$
XLabel=$E$ [GeV]
YLabel=$\mathrm{d}\sigma / \mathrm{d}E$ [pb/GeV]
LogY=1
# END PLOT

# BEGIN PLOT /DecayRiv/(.*_)?momentum$
XLabel=$|p|$ [GeV]
YLabel=$\mathrm{d}\sigma / \mathrm{d}|p|$ [pb/GeV]
LogY=1
# END PLOT

# BEGIN PLOT /DecayRiv/(.*_)?pt$
XLabel=$p_T$ [GeV]
YLabel=$\mathrm{d}\sigma / \mathrm{d}p_T$ [pb/GeV]
LogY=1
# END PLOT

# BEGIN PLOT /DecayRiv/(.*_)?pz$
XLabel=$p_z$ [GeV]
YLabel=$\mathrm{d}\sigma / \mathrm{d}p_z$ [pb/GeV]
LogY=1
# END PLOT

# BEGIN PLOT /DecayRiv/(.*_)?eta$
XLabel=$\eta$
YLabel=$\mathrm{d}\sigma / \mathrm{d}\eta$ [pb]
# END PLOT

# BEGIN PLOT /DecayRiv/(.*_)?count$
XLabel=candidates per event
YLabel=$\mathrm{d}\sigma / \mathrm{d}N$ [pb]
LogY=1
# END PLOT
