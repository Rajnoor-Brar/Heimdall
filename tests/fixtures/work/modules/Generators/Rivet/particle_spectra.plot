# BEGIN PLOT /particle_spectra/pt
Title=stable particles
XLabel=$p_T$ [GeV]
YLabel=$1/N \, \mathrm{d}N/\mathrm{d}p_T$ [1/GeV]
LogY=1
# END PLOT

# BEGIN PLOT /particle_spectra/energy
Title=stable particles
XLabel=$E$ [GeV]
YLabel=$1/N \, \mathrm{d}N/\mathrm{d}E$ [1/GeV]
LogY=1
# END PLOT

# BEGIN PLOT /particle_spectra/eta
Title=stable particles
XLabel=$\eta$
YLabel=$1/N \, \mathrm{d}N/\mathrm{d}\eta$
LogY=0
# END PLOT

# BEGIN PLOT /particle_spectra/nch
Title=charged particles
XLabel=$N_\text{ch}$
YLabel=$P(N_\text{ch})$
LogY=1
# END PLOT
