# photo_eic plot styling. Legend titles describe the default cuts (ETMIN = 5, ETMIN2 = 10,
# ETAMAX = 3.5); beam energy is carried by the sweep legend labels.

# BEGIN PLOT /photo_eic/d01-x01-y01
Title=
XLabel=$E_T$ [GeV]
YLabel=$\mathrm{d}\sigma / \mathrm{d}E_T$ [pb/GeV]
LegendTitle=$-3.5 < \eta < 3.5, k_T$ alg 
LogY=1
# END PLOT

# BEGIN PLOT /photo_eic/d02-x01-y01
Title=
XLabel=$\eta$
YLabel=$\mathrm{d}\sigma / \mathrm{d}\eta$ [pb]
LegendTitle=$E_T > 5$ GeV, $k_T$ alg 
LogY=0
# END PLOT

# BEGIN PLOT /photo_eic/d03-x01-y01
Title=
XLabel=$\eta$
YLabel=$\mathrm{d}\sigma / \mathrm{d}\eta$ [pb]
LegendTitle=$E_T > 10$ GeV, $k_T$ alg 
LogY=0
# END PLOT

